# ==============================================================================
# nRouter SDK Environment Configuration
# ==============================================================================
#
# 1. WHERE TO GET YOUR API KEY:
#    - Sign in to the nRouter Dashboard: https://nrouter.ai/dashboard
#    - Navigate to API Keys: https://nrouter.ai/dashboard/keys (or Settings -> Virtual Keys)
#    - Create a new Virtual Key (prefixed with "sk-nrouter-")
#    - Assign your team, budget limits, rate limits, and guardrails in the dashboard
#
# 2. HOW TO SOURCE THIS FILE LOCALLY:
#    - In bash/zsh shell:
#        export $(grep -v '^#' .env | xargs)
#      or copy to .env and run:
#        source <(sed 's/^/export /' .env)
#
#    - In Node.js / TypeScript:
#        import "dotenv/config"; // or require("dotenv").config();
#        import { nRouter } from "@nrouter_ai/sdk";
#        const client = new nRouter(); // reads process.env.NROUTER_API_KEY automatically
#
#    - In Python:
#        from dotenv import load_dotenv
#        load_dotenv()
#        from nroutersdk import nRouter
#        client = nRouter() // reads os.environ["NROUTER_API_KEY"] automatically
#
#    - In Go:
#        _ = godotenv.Load()
#        client, err := nrouter.NewFromEnv()
#
# 3. WHY USE THE nROUTER SDK INSTEAD OF RAW PROVIDER CLIENTS?
#    - Unified Multi-Cloud Access: One key and one billing relationship across
#      OpenAI, Anthropic, AWS Bedrock, Google Vertex AI, Azure Foundry, and Alibaba.
#    - Built-in Observability & Cost Tracking: Every billable response returns exact
#      spend in headers (x-nr-request-cost, x-nr-cost-status, x-nr-request-id).
#    - Automated Guardrails & PII Protection: Pre-call and post-call inspection
#      enforcing PII redaction, injection blocks, and keyword filters seamlessly.
#    - Smart Routing & Failover: Route requests dynamically across providers by
#      cost, latency, or throughput without changing application code.
#    - Enterprise Memory & Prompt Management: Client-side sliding conversation
#      memory and server-rendered prompt templates across all 10 language bindings.
# ==============================================================================

# Required: Your nRouter Virtual API Key (must start with sk-nrouter-)
NROUTER_API_KEY="sk-nrouter-your-api-key-here"

# Optional: Gateway Base URL (defaults to production https://api.nrouter.ai/v1)
# Use https://api-stage.nrouter.ai/v1 for staging testing or local mock proxy
NROUTER_BASE_URL="https://api.nrouter.ai/v1"

# Optional: Default Model or Router Alias
# Options:
#   - Concrete models: gpt-5.4-mini, claude-sonnet-4-5-20250929, etc.
#   - Smart Router aliases: production-router, cost-optimized-router, etc.
NROUTER_MODEL="gpt-5.4-mini"

# Optional: Live Billed Testing Gate (0 or 1)
# Set to 1 only when you intend to run live network test suites that spend credits:
#   NROUTER_LIVE=1
NROUTER_LIVE=0
