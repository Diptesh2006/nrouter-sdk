{
  "name": "@nrouter_ai/sdk",
  "version": "2.2.0",
  "description": "nRouter SDK — one API key for models across six provider clouds. Native OpenAI and Anthropic wire formats, plus embeddings, audio, images and video.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node test/smoke.js"
  },
  "keywords": [
    "llm",
    "ai",
    "nrouter",
    "gateway",
    "llm-gateway",
    "openai",
    "anthropic",
    "claude",
    "bedrock",
    "vertex-ai",
    "azure",
    "qwen",
    "api"
  ],
  "author": "nRouter <hello@nrouter.ai>",
  "homepage": "https://nrouter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nRouterAI/nrouter-sdk.git",
    "directory": "sdks/js"
  },
  "bugs": {
    "url": "https://github.com/nRouterAI/nrouter-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
